# Salin menjadi .env.local lalu isi. Tanpa Supabase, aplikasi berjalan dalam mode demo.

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Rahasia, hanya dipakai di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Email yang boleh masuk dashboard admin (pisahkan dengan koma)
ADMIN_EMAILS=

# Alamat undangan setelah online, misal https://frisca-arif.vercel.app
NEXT_PUBLIC_SITE_URL=
